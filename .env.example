# Omni-RLM backend configuration
# Copy this file to `.env` and fill in real values.
# Example: cp .env.example .env

# API key used for Authorization. Supported names in loader:
# - DASHSCOPE_API_KEY
# - OPENAI_API_KEY
# You can also reference an existing shell env var, e.g. ${MOONSHOT_API_KEY} or $MOONSHOT_API_KEY
OMNIRLM_API_KEY=sk-your-api-key-here

# Full OpenAI-compatible chat completions endpoint URL
OMNIRLM_BASE_URL=your-endpoint-url-here

# Model name served by your backend
OMNIRLM_MODEL_NAME=your-model-name-here
